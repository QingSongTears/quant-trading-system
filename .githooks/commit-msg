#!/bin/sh
# .githooks/commit-msg - shell wrapper
# Calls .githooks/commit-msg.py to validate commit message

if command -v python >/dev/null 2>&1; then
    PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    echo "[FAIL] No python found in PATH" >&2
    exit 1
fi

cd "$(dirname "$0")/.." || exit 1

# Pass all args (git passes message file as $1)
exec "$PYTHON" "$(dirname "$0")/commit-msg.py" "$@"
